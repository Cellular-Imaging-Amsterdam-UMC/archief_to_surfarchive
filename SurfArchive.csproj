<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SurfDataArchiveTransfer</AssemblyName>
    <Product>SurfDataArchiveTransfer</Product>
    <Version>2.0.0</Version>
    <RootNamespace>SurfArchive</RootNamespace>
    <ApplicationIcon>Assets\SurfArchive.ico</ApplicationIcon>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.1" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.15" />
    <EmbeddedResource Include="Assets\ActionIcons.png" LogicalName="SurfArchive.ActionIcons.png" />
  </ItemGroup>
</Project>
